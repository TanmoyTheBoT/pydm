#define AppName "@APP_NAME@"
#define AppVersion "@VERSION@"
#define PortableDir "@PORTABLE_DIR@"

[Setup]
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher=TanmoyTheBoT
AppPublisherURL=https://github.com/TanmoyTheBoT
AppSupportURL=https://github.com/TanmoyTheBoT/pydm
AppUpdatesURL=https://github.com/TanmoyTheBoT/pydm
DefaultDirName={commonpf64}\{#AppName}
DefaultGroupName={#AppName}
OutputDir=dist
VersionInfoVersion=@VERSION_FILE@
VersionInfoTextVersion=@VERSION@
OutputBaseFilename=PyDM-v{#AppVersion}-Windows-x64-Installer
Compression=lzma2
SolidCompression=yes
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog
SetupIconFile=src\pydm\assets\icon.ico
UninstallDisplayIcon={app}\pydm.exe

[Files]
Source: "{#PortableDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\pydm.exe"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"
